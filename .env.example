# Claude API Configuration
CLAUDE_API_KEY=your_api_key_here

# Enable Claude Trace - Set to true to enable detailed request/response logging
CLAUDE_TRACE=true

# Trace Level: debug, info, warn, error
TRACE_LEVEL=debug

# Log trace output to file
TRACE_OUTPUT_FILE=./logs/claude_trace.log

# Enable console trace output
TRACE_CONSOLE=true

# Include request/response bodies in trace
TRACE_INCLUDE_BODIES=true

# Include headers in trace
TRACE_INCLUDE_HEADERS=true

# Include timing information
TRACE_INCLUDE_TIMING=true
